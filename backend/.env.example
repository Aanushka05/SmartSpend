# ─────────────────────────────────────────────
#  SmartSpend Backend — Environment Variables
# ─────────────────────────────────────────────

# Server
PORT=3001
NODE_ENV=development

# Security — CHANGE THESE IN PRODUCTION
JWT_SECRET=smartspend_super_secret_jwt_key_change_in_prod
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=smartspend_refresh_secret_change_in_prod
REFRESH_TOKEN_EXPIRES_IN=30d

# Database
DB_PATH=./data/smartspend.db

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Currency API (optional — free tier at exchangerate-api.com)
CURRENCY_API_KEY=your_api_key_here
CURRENCY_API_URL=https://v6.exchangerate-api.com/v6

# Admin seed credentials (used by seed.js ONLY)
ADMIN_EMAIL=admin@smartspend.com
ADMIN_PASSWORD=anushka
ADMIN_NAME=System Administrator
